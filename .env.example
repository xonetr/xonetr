# Repositorio de contenido. Usa "api" para el backend FastAPI.
VITE_CONTENT_BACKEND=api

# Autenticación administrada por FastAPI.
# Crea .env.local con estos valores y usa backend/.env para las credenciales reales.
VITE_ADMIN_AUTH=true
VITE_ADMIN_AUTH_BACKEND=api

# Endpoint opcional del formulario público.
VITE_FORM_ENDPOINT=

# Desactiva la pantalla de carga pública sin modificar el código.
VITE_PRELOADER=true
