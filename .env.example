# Repositorio de contenido: "local" por defecto. "cloudflare" aún no está implementado.
VITE_CONTENT_BACKEND=local

# Credenciales exclusivamente para la simulación local del panel.
# Copia este archivo como .env.local y reemplaza estos valores.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change-this-local-password

# Endpoint opcional del formulario público.
VITE_FORM_ENDPOINT=
