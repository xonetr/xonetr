ADMIN_EMAIL=admin@xonetr.com
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=backend/data/xonetr.sqlite3
MEDIA_DIRECTORY=backend/data/media
# Clave que cifra en reposo las claves privadas Ed25519 de las licencias (openssl rand -hex 32).
# Guardala fuera de la base y con copia de seguridad: sin ella no se pueden volver a usar las claves guardadas.
# También se puede pasar como archivo con SIGNING_KEY_SECRET_FILE=/run/secrets/signing_key_secret.
SIGNING_KEY_SECRET=replace-with-another-long-random-secret
